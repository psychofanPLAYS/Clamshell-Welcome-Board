#!/usr/bin/env python3
"""Daily Claude Code + Codex updater with rolling shell notification.

Cron runs the update path. Interactive shells call --notify-shell from ~/.bashrc.
The notification reads saved JSON receipts, so opening many terminals does not
rerun any updater commands.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
from datetime import date, datetime, timedelta
from pathlib import Path
from typing import Any


def _bounded_env_int(name: str, default: int, minimum: int, maximum: int) -> int:
    try:
        value = int(os.environ.get(name, str(default)))
    except ValueError:
        return default
    return max(minimum, min(value, maximum))


STATE_DIR = Path.home() / ".AGENTS" / ".state"
STATE_PATH = Path(
    os.environ.get(
        "CODEX_CLAUDE_UPDATE_STATE",
        str(STATE_DIR / "codex-claude-daily-update.json"),
    )
)
LOG_PATH = Path(
    os.environ.get(
        "CODEX_CLAUDE_UPDATE_LOG",
        str(Path.home() / ".AGENTS" / "logs" / "codex-claude-daily-update.log"),
    )
)
HISTORY_DAYS = _bounded_env_int("CODEX_CLAUDE_UPDATE_HISTORY_DAYS", 7, 1, 30)
MAX_LOG_READ_BYTES = _bounded_env_int(
    "CODEX_CLAUDE_UPDATE_MAX_LOG_READ_BYTES",
    1_048_576,
    4_096,
    10_485_760,
)

DEFAULT_PATH = ":".join(
    [
        str(Path.home() / ".npm-global" / "bin"),
        str(Path.home() / ".local" / "bin"),
        "/home/linuxbrew/.linuxbrew/bin",
        "/usr/local/bin",
        "/usr/bin",
        "/bin",
    ]
)

TOOLS = [
    {
        "key": "claude",
        "label": "Claude",
        "version_cmd": ["claude", "--version"],
        "update_cmd": ["claude", "update"],
    },
    {
        "key": "codex",
        "label": "Codex",
        "version_cmd": ["codex", "--version"],
        "update_cmd": ["npm", "install", "-g", "@openai/codex@latest"],
    },
]


def _env() -> dict[str, str]:
    env = os.environ.copy()
    env["PATH"] = DEFAULT_PATH + ":" + env.get("PATH", "")
    env.setdefault("NPM_CONFIG_PREFIX", str(Path.home() / ".npm-global"))
    env.setdefault("HOME", str(Path.home()))
    return env


def _run(cmd: list[str], timeout: int = 900) -> dict[str, Any]:
    started = datetime.now().astimezone().isoformat()
    try:
        proc = subprocess.run(
            cmd,
            env=_env(),
            text=True,
            capture_output=True,
            timeout=timeout,
            check=False,
        )
        return {
            "cmd": cmd,
            "started": started,
            "returncode": proc.returncode,
            "stdout": proc.stdout.strip(),
            "stderr": proc.stderr.strip(),
        }
    except subprocess.TimeoutExpired as exc:
        return {
            "cmd": cmd,
            "started": started,
            "returncode": 124,
            "stdout": (exc.stdout or "").strip() if isinstance(exc.stdout, str) else "",
            "stderr": "timed out",
        }


def _version(tool: dict[str, Any]) -> str | None:
    result = _run(tool["version_cmd"], timeout=60)
    text = "\n".join(part for part in [result["stdout"], result["stderr"]] if part)
    if result["returncode"] != 0 or not text.strip():
        return None
    return _first_version(text) or text.strip().splitlines()[0].strip()


def _first_version(text: str) -> str | None:
    match = re.search(r"\d+(?:\.\d+)+(?:[-+][0-9A-Za-z.-]+)?", text)
    return match.group(0) if match else None


def _append_log(receipt: dict[str, Any]) -> None:
    LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
    with LOG_PATH.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(receipt, ensure_ascii=False) + "\n")


def _write_state(receipt: dict[str, Any]) -> None:
    STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE_PATH.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(receipt, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    tmp.replace(STATE_PATH)


def run_daily_update() -> int:
    """Run both updaters and persist a receipt when either version changes."""
    receipt: dict[str, Any] = {
        "date": date.today().isoformat(),
        "timestamp": datetime.now().astimezone().isoformat(),
        "tools": [],
        "updated": [],
    }
    exit_code = 0

    for tool in TOOLS:
        before = _version(tool)
        update_result = _run(tool["update_cmd"])
        after = _version(tool)
        changed = bool(before and after and before != after)
        entry = {
            "key": tool["key"],
            "label": tool["label"],
            "before": before,
            "after": after,
            "changed": changed,
            "update_returncode": update_result["returncode"],
            "update_stdout_tail": "\n".join(update_result["stdout"].splitlines()[-12:]),
            "update_stderr_tail": "\n".join(update_result["stderr"].splitlines()[-12:]),
        }
        receipt["tools"].append(entry)
        if changed:
            receipt["updated"].append(entry)
        if update_result["returncode"] != 0:
            exit_code = update_result["returncode"] or 1

    _append_log(receipt)
    if receipt["updated"]:
        _write_state(receipt)
    return exit_code


def _load_state() -> dict[str, Any] | None:
    try:
        return json.loads(STATE_PATH.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError):
        return None


def _relative_day_label(update_date: date) -> str | None:
    today = date.today()
    if update_date == today:
        return "TODAY"
    if update_date == today - timedelta(days=1):
        return "YESTERDAY"
    return None


def _day_word(days: int) -> str:
    return "day" if days == 1 else "days"


def _display_day_label(update_date: date) -> str:
    return _relative_day_label(update_date) or update_date.strftime("%b %d").upper()


def _parse_receipt_date(receipt: dict[str, Any]) -> date | None:
    try:
        return date.fromisoformat(str(receipt["date"]))
    except (KeyError, ValueError):
        return None


def _parse_receipt_time(receipt: dict[str, Any]) -> str:
    timestamp = str(receipt.get("timestamp") or "")
    try:
        parsed = datetime.fromisoformat(timestamp)
    except ValueError:
        return "--:--"
    return parsed.strftime("%H:%M")


def _read_recent_log_lines(max_bytes: int = MAX_LOG_READ_BYTES) -> list[str]:
    try:
        with LOG_PATH.open("rb") as handle:
            handle.seek(0, os.SEEK_END)
            size = handle.tell()
            if size > max_bytes:
                handle.seek(-max_bytes, os.SEEK_END)
                handle.readline()
            else:
                handle.seek(0)
            data = handle.read()
    except OSError:
        return []
    return data.decode("utf-8", errors="replace").splitlines()


def _iter_log_receipts(max_bytes: int = MAX_LOG_READ_BYTES) -> list[dict[str, Any]]:
    receipts: list[dict[str, Any]] = []
    for line in _read_recent_log_lines(max_bytes=max_bytes):
        if not line.strip():
            continue
        try:
            receipt = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(receipt, dict):
            receipts.append(receipt)
    return receipts


def _receipt_key(receipt: dict[str, Any]) -> tuple[str, str]:
    return (str(receipt.get("date") or ""), str(receipt.get("timestamp") or ""))


def _load_recent_update_receipts(days: int = HISTORY_DAYS) -> list[dict[str, Any]]:
    """Return changed-version receipts from the rolling N-day window."""
    window_days = max(1, days)
    today = date.today()
    cutoff = today - timedelta(days=window_days - 1)
    receipts = _iter_log_receipts()
    state = _load_state()
    if state and _receipt_key(state) not in {_receipt_key(item) for item in receipts}:
        receipts.append(state)

    recent: list[dict[str, Any]] = []
    for receipt in receipts:
        receipt_date = _parse_receipt_date(receipt)
        if not receipt_date or receipt_date < cutoff or receipt_date > today:
            continue
        if receipt.get("updated"):
            recent.append(receipt)

    recent.sort(key=lambda item: str(item.get("timestamp") or item.get("date") or ""), reverse=True)
    return recent


def notify_shell() -> int:
    """Print colored rolling update history without running update commands."""
    receipts = _load_recent_update_receipts()
    if not receipts:
        return 0

    cream = "\033[38;5;230m"
    teal = "\033[38;5;50m"
    orange = "\033[38;5;214m"
    green = "\033[38;5;118m"
    purple = "\033[38;5;183m"
    dim = "\033[38;5;245m"
    reset = "\033[0m"
    bold = "\033[1m"

    rows: list[tuple[str, str]] = []
    title_plain = f"AGENT CLI UPDATE HISTORY - LAST {HISTORY_DAYS} {_day_word(HISTORY_DAYS).upper()}"
    title_color = (
        f"{purple}{bold}AGENT CLI UPDATE HISTORY{reset} "
        f"{dim}- last {HISTORY_DAYS} {_day_word(HISTORY_DAYS)}{reset}"
    )
    rows.append((title_plain, title_color))

    for receipt in receipts:
        receipt_date = _parse_receipt_date(receipt)
        if not receipt_date:
            continue
        day_label = _display_day_label(receipt_date)
        update_time = _parse_receipt_time(receipt)
        for entry in receipt.get("updated", []):
            label = str(entry.get("label") or entry.get("key") or "Tool")
            before = str(entry.get("before") or "unknown")
            after = str(entry.get("after") or "unknown")
            prefix_plain = f"{day_label:>9} {update_time}"
            plain = f"{prefix_plain}  {label}: {before} -> {after}"
            colored = (
                f"{purple}{bold}{day_label:>9}{reset} {dim}{update_time}{reset}"
                f"{cream}  {teal}{bold}{label}{reset}{cream}: "
                f"{orange}{before}{cream} -> {green}{bold}{after}{reset}"
            )
            rows.append((plain, colored))

    if len(rows) == 1:
        return 0

    width = max(len(plain) for plain, _ in rows) + 4
    border = "+" + "-" * width + "+"
    welcome_board_width = 80
    welcome_board_left_pad = 2
    indent = " " * max(0, welcome_board_left_pad + (welcome_board_width - len(border)) // 2)

    print(f"{indent}{teal}{border}{reset}")
    for plain, colored in rows:
        pad = " " * (width - len(plain) - 2)
        print(f"{indent}{teal}|{reset} {colored}{pad} {teal}|{reset}")
    print(f"{indent}{teal}{border}{reset}")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--notify-shell", action="store_true", help="print rolling update history banner")
    parser.add_argument("--state-path", action="store_true", help="print the JSON state path")
    args = parser.parse_args(argv)

    if args.notify_shell:
        return notify_shell()
    if args.state_path:
        print(STATE_PATH)
        return 0
    return run_daily_update()


if __name__ == "__main__":
    raise SystemExit(main())
