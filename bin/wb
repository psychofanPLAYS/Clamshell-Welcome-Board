#!/usr/bin/env bash
set -euo pipefail

WB_SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
WB_REPO_ROOT="$(cd -- "$WB_SCRIPT_DIR/.." && pwd)"
WB_CONFIG="${WELCOME_BOARD_CONFIG:-$HOME/.config/welcome-board/config}"
WB_BOARD_FILE="${WELCOME_BOARD_BOARD_FILE:-$WB_REPO_ROOT/welcome-board.sh}"
if [ ! -r "$WB_BOARD_FILE" ] && [ -r "$HOME/.local/share/welcome-board/welcome-board.sh" ]; then
  WB_BOARD_FILE="$HOME/.local/share/welcome-board/welcome-board.sh"
fi

wb_usage() {
  cat <<'EOF'
wb - terminal welcome board helper

Usage:
  wb                 Render the board
  wb help            Show this help
  wb setup           Ask basic questions and write config
  wb theme           Show available themes
  wb theme NAME      Set theme
  wb sections        Show configured sections
  wb doctor          Read-only install/readiness check
  wb ports scan      Read-only listening-port scan
  wb ports explain   Read-only plain-English port explanation
  wb ports plan      Print a dry-run lockdown plan
  wb ports snapshot  Save current reviewed listeners as the warning baseline

Also installed:
  welcomeboard -> wb

Safety:
  wb ports scan/explain/plan/snapshot are read-only. Firewall changes are not
  implemented here.
EOF
}

wb_config_dir() {
  dirname -- "$WB_CONFIG"
}

wb_config_get() {
  local key="$1"
  if [ -r "$WB_CONFIG" ]; then
    awk -F= -v k="$key" '$1==k {gsub(/^"|"$/, "", $2); print $2; exit}' "$WB_CONFIG"
  fi
}

wb_config_quote() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '"%s"' "$value"
}

wb_config_set() {
  local key="$1" value="$2" dir tmp
  dir="$(wb_config_dir)"
  mkdir -p "$dir"
  tmp="${WB_CONFIG}.tmp.$$"
  if [ -r "$WB_CONFIG" ]; then
    awk -F= -v k="$key" '$1!=k {print}' "$WB_CONFIG" > "$tmp"
  else
    : > "$tmp"
  fi
  printf '%s=%s\n' "$key" "$(wb_config_quote "$value")" >> "$tmp"
  mv "$tmp" "$WB_CONFIG"
}

wb_theme_list() {
  cat <<'EOF'
Available themes:
  cyan-dark       cool cyan rails, dark terminal
  amber-terminal  orange/gold terminal style
  green-phosphor  green monochrome terminal style
  light-paper     light terminal, dark text, interview-safe
  mono-safe       minimal color for compatibility
EOF
}

wb_theme_set() {
  case "$1" in
    cyan-dark|amber-terminal|green-phosphor|light-paper|mono-safe)
      wb_config_set WB_THEME "$1"
      printf 'Theme set: %s\n' "$1"
      ;;
    *)
      printf 'Unknown theme: %s\n\n' "$1" >&2
      wb_theme_list >&2
      return 2
      ;;
  esac
}

wb_setup() {
  local name banner theme sections custom_file service_ports baseline_file hermes_label openclaw_path
  printf 'Display name [%s]: ' "${USER:-you}"
  read -r name
  name="${name:-${USER:-you}}"

  printf 'Banner text [%s]: ' "$(hostname -s 2>/dev/null || printf WORKSTATION)"
  read -r banner
  banner="${banner:-$(hostname -s 2>/dev/null || printf WORKSTATION)}"

  wb_theme_list
  printf 'Theme [cyan-dark]: '
  read -r theme
  theme="${theme:-cyan-dark}"
  case "$theme" in
    cyan-dark|amber-terminal|green-phosphor|light-paper|mono-safe) ;;
    *) printf 'Unknown theme, using cyan-dark.\n'; theme="cyan-dark" ;;
  esac

  printf 'Sections [machine services identity security health hermes tmux commands notes]: '
  read -r sections
  sections="${sections:-machine services identity security health hermes tmux commands notes}"

  printf 'Custom commands file [blank to skip]: '
  read -r custom_file

  printf 'Service ports to watch, name:port pairs [blank for auto]: '
  read -r service_ports

  printf 'Hermes label [blank for auto/skip]: '
  read -r hermes_label

  printf 'OpenClaw path [blank to auto-detect later]: '
  read -r openclaw_path

  printf 'Port baseline file [~/.local/state/welcome-board/ports-baseline.txt]: '
  read -r baseline_file

  mkdir -p "$(wb_config_dir)"
  {
    printf 'WB_DISPLAY_NAME=%s\n' "$(wb_config_quote "$name")"
    printf 'WB_BANNER_TEXT=%s\n' "$(wb_config_quote "$banner")"
    printf 'WB_THEME=%s\n' "$(wb_config_quote "$theme")"
    printf 'WB_SECTIONS=%s\n' "$(wb_config_quote "$sections")"
    [ -n "$custom_file" ] && printf 'WB_CUSTOM_COMMANDS_FILE=%s\n' "$(wb_config_quote "$custom_file")"
    [ -n "$service_ports" ] && printf 'WB_SERVICE_PORTS=%s\n' "$(wb_config_quote "$service_ports")"
    [ -n "$hermes_label" ] && printf 'WB_HERMES_LABEL=%s\n' "$(wb_config_quote "$hermes_label")"
    [ -n "$openclaw_path" ] && printf 'WB_OPENCLAW_PATH=%s\n' "$(wb_config_quote "$openclaw_path")"
    [ -n "$baseline_file" ] && printf 'WB_PORT_BASELINE_FILE=%s\n' "$(wb_config_quote "$baseline_file")"
  } > "$WB_CONFIG"

  printf 'Wrote %s\n' "$WB_CONFIG"
  printf 'Tip: review wb ports explain, then run wb ports snapshot to create the drift baseline.\n'
}

wb_sections() {
  local sections
  sections="$(wb_config_get WB_SECTIONS)"
  printf 'Sections: %s\n' "${sections:-machine services identity security health hermes tmux commands notes}"
}

wb_doctor_cmd() {
  local label="$1" cmd="$2"
  if command -v "$cmd" >/dev/null 2>&1; then
    printf '  %-12s ok (%s)\n' "$label" "$(command -v "$cmd")"
  else
    printf '  %-12s missing\n' "$label"
  fi
}

wb_doctor() {
  local platform scanner="missing"
  platform="$(uname -s 2>/dev/null || printf unknown)"
  if command -v ss >/dev/null 2>&1; then
    scanner="ss"
  elif command -v lsof >/dev/null 2>&1; then
    scanner="lsof"
  elif command -v netstat >/dev/null 2>&1; then
    scanner="netstat"
  fi

  printf 'Welcome Board doctor\n'
  printf 'platform: %s\n' "$platform"
  printf 'bash: %s\n' "${BASH_VERSION:-unknown}"
  if [ -r "$WB_CONFIG" ]; then
    printf 'config: ok (%s)\n' "$WB_CONFIG"
  else
    printf 'config: not created yet (run wb setup)\n'
  fi
  if [ -r "$WB_BOARD_FILE" ]; then
    printf 'board: ok (%s)\n' "$WB_BOARD_FILE"
  else
    printf 'board: missing (%s)\n' "$WB_BOARD_FILE"
  fi
  printf 'port scanner: %s\n' "$scanner"
  printf 'commands:\n'
  wb_doctor_cmd wb wb
  wb_doctor_cmd welcomeboard welcomeboard
  wb_doctor_cmd tmux tmux
  wb_doctor_cmd figlet figlet
  wb_doctor_cmd nvidia-smi nvidia-smi
  printf 'No files, services, ports, or firewall rules were changed.\n'
}

wb_ports_scan() {
  if command -v ss >/dev/null 2>&1; then
    ss -tuln
  elif command -v lsof >/dev/null 2>&1; then
    lsof -iTCP -sTCP:LISTEN -P -n
  elif command -v netstat >/dev/null 2>&1; then
    netstat -an
  else
    printf 'No supported port scanner found (need ss, lsof, or netstat).\n' >&2
    return 1
  fi
}

wb_ports_lines() {
  if command -v ss >/dev/null 2>&1; then
    ss -tulnHp 2>/dev/null || ss -tuln
  elif command -v lsof >/dev/null 2>&1; then
    lsof -iTCP -sTCP:LISTEN -P -n
  elif command -v netstat >/dev/null 2>&1; then
    netstat -an
  else
    printf 'No supported port scanner found (need ss, lsof, or netstat).\n' >&2
    return 1
  fi
}

wb_ports_short_name() {
  case "$1" in
    22) printf 'SSH' ;;
    53) printf 'DNS' ;;
    137|138|139|445) printf 'Samba' ;;
    631) printf 'printing' ;;
    3000|5173|8000|8080) printf 'common dev server' ;;
    5432) printf 'Postgres' ;;
    6379) printf 'Redis' ;;
    5353) printf 'mDNS' ;;
    6333) printf 'vector DB' ;;
    6900) printf 'webdash' ;;
    6901) printf 'embedder' ;;
    6902) printf 'reranker' ;;
    6903) printf 'Honcho' ;;
    6904) printf 'PupCam' ;;
    6905) printf 'shim log' ;;
    6906) printf 'cockpit aux' ;;
    6907) printf 'messageboard' ;;
    6908) printf 'cockpit' ;;
    6909) printf 'local app' ;;
    6911) printf 'Kenny LM' ;;
    6912) printf 'Hermes API' ;;
    6913) printf 'Kenny gate' ;;
    6915) printf 'Hermes dash' ;;
    6916) printf 'Hermes' ;;
    6917) printf 'OR guard' ;;
    6925) printf 'auto-life' ;;
    6974) printf 'PupCam' ;;
    6996) printf 'LM proxy' ;;
    443|8443|8444) printf 'Tailnet HTTPS' ;;
    9277) printf 'Warp terminal' ;;
    36900) printf 'cockpit' ;;
    37360) printf 'media' ;;
    *) printf 'port %s' "$1" ;;
  esac
}

wb_ports_summary_lines() {
  local line field addr port process
  wb_ports_lines | while IFS= read -r line; do
    case "$line" in
      Netid*|State*|COMMAND*|"") continue ;;
    esac
    addr=""
    port=""
    for field in $line; do
      field="${field#[}"
      field="${field%]}"
      if [[ "$field" =~ ^(.+):([0-9]+)$ ]]; then
        addr="${BASH_REMATCH[1]}"
        port="${BASH_REMATCH[2]}"
        break
      fi
    done
    [ -n "$port" ] || continue
    process="unknown"
    if [[ "$line" =~ users:\(\(\"([^\"]+)\" ]]; then
      process="${BASH_REMATCH[1]}"
    elif [[ "$line" =~ ([A-Za-z0-9_.-]+),pid= ]]; then
      process="${BASH_REMATCH[1]}"
    fi
    printf '%s:%s(%s)\n' "$(wb_ports_short_name "$port")" "$port" "$process"
  done | sort -u
}

wb_ports_snapshot() {
  local baseline dir
  baseline="$(wb_config_get WB_PORT_BASELINE_FILE)"
  baseline="${baseline:-$HOME/.local/state/welcome-board/ports-baseline.txt}"
  dir="$(dirname -- "$baseline")"
  mkdir -p "$dir"
  wb_ports_summary_lines > "$baseline"
  printf 'Saved reviewed port baseline: %s\n' "$baseline"
  printf 'Review this file when SECURITY warns about newly open listeners.\n'
  printf 'No firewall changes were made.\n'
}

wb_ports_report() {
  local mode="${1:-explain}" tmp line field addr port process scope known
  tmp="$(mktemp)"
  wb_ports_lines > "$tmp"

  if [ "$mode" = "plan" ]; then
    printf 'Dry-run port lockdown plan\n'
    printf 'No commands were executed.\n\n'
    printf 'Step 1: review these LAN-visible listeners with the user.\n'
  else
    printf 'Read-only port explanation\n'
    printf 'No firewall changes were made.\n\n'
  fi

  while IFS= read -r line; do
    case "$line" in
      Netid*|State*|COMMAND*|"") continue ;;
    esac
    addr=""
    port=""
    for field in $line; do
      field="${field#[}"
      field="${field%]}"
      if [[ "$field" =~ ^(.+):([0-9]+)$ ]]; then
        addr="${BASH_REMATCH[1]}"
        port="${BASH_REMATCH[2]}"
        break
      fi
    done
    [ -n "$port" ] || continue
    process="unknown"
    if [[ "$line" =~ users:\(\(\"([^\"]+)\" ]]; then
      process="${BASH_REMATCH[1]}"
    elif [[ "$line" =~ ([A-Za-z0-9_.-]+),pid= ]]; then
      process="${BASH_REMATCH[1]}"
    fi

    scope="LAN-visible"
    case "$addr" in
      127.*|::1|\[::1\]|localhost) scope="loopback" ;;
      100.*|fd7a:*|fe80:*) scope="VPN/private" ;;
    esac

    known=""
    case "$port" in
      22) known="SSH: do not block until you have another login path" ;;
      3000|5173|8000|8080) known="common dev server; keep only if you use it" ;;
      5432) known="Postgres; usually local-only" ;;
      6379) known="Redis; usually local-only" ;;
      5353) known="mDNS/Bonjour; normal on many desktops" ;;
      *) known="ask whether this is intentionally used" ;;
    esac

    printf '%s  %s:%s  process=%s  %s\n' "$scope" "$addr" "$port" "$process" "$known"
  done < "$tmp"
  rm -f "$tmp"

  if [ "$mode" = "plan" ]; then
    cat <<'EOF'

Step 2: ask the user which LAN-visible ports they personally use.
Step 3: keep SSH only when another login path or local console is confirmed.
Step 4: if a future version generates firewall commands, review them separately.
Step 5: save rollback commands before any future mutating security change.

This command is a dry run. It does not enable ufw, pfctl, iptables, nft, or any firewall.
EOF
  fi
}

wb_render() {
  export WELCOME_BOARD_CONFIG="$WB_CONFIG"
  # shellcheck source=/dev/null
  source "$WB_BOARD_FILE"
  clamboard
}

cmd="${1:-render}"
case "$cmd" in
  render) wb_render ;;
  help|-h|--help) wb_usage ;;
  setup) wb_setup ;;
  doctor) wb_doctor ;;
  theme)
    if [ "${2:-}" ]; then wb_theme_set "$2"; else wb_theme_list; fi
    ;;
  sections) wb_sections ;;
  ports)
    case "${2:-}" in
      scan) wb_ports_scan ;;
      explain) wb_ports_report explain ;;
      plan) wb_ports_report plan ;;
      snapshot) wb_ports_snapshot ;;
      apply|rollback) printf 'wb ports %s is not implemented because it would be mutating. Use scan/explain/plan first.\n' "$2" >&2; exit 2 ;;
      ""|help|-h|--help) printf 'Usage: wb ports {scan|explain|plan|snapshot}\n' ;;
      *) printf 'Unknown ports command: %s\n' "$2" >&2; exit 2 ;;
    esac
    ;;
  *) printf 'Unknown command: %s\n\n' "$cmd" >&2; wb_usage >&2; exit 2 ;;
esac
